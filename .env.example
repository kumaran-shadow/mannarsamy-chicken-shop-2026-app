# Backend configuration variables
# Copy these to a .env file inside the 'backend' folder

PORT=3000
UPI_ID=your_upi_id_here@provider
MERCHANT_NAME=Your Merchant Name
PAYMENT_WEBHOOK_SECRET=your_secure_webhook_secret_here
WHATSAPP_PHONE=your_whatsapp_phone_number_with_country_code
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
PAYMENT_PROVIDER_KEY=your_payment_provider_key
PAYMENT_PROVIDER_SECRET=your_payment_provider_secret

# Frontend production environment variables
# Set this in Vercel settings under Environment Variables
VITE_PRODUCTION_VIDEO_URL=https://your-cdn-or-cloud-hosting.com/video/shop_tour.mp4
